# ============================================================================
# Bizzio.online — Environment Variables
# Copy this file to .env.local and fill in the real values.
# Never commit .env.local — it is already in .gitignore.
# ============================================================================

# ---- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://bizzio.online
NEXT_PUBLIC_APP_NAME=Bizzio Online

# ---- Supabase ----------------------------------------------------------------
# Project URL and keys: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://omiufzflbajihzyszgdi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, NEVER expose to the browser.
# Used for: admin actions (creating auth users on approval/invite), the
# seed-superadmin script, and the health check.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Resend (transactional email) ------------------------------------------
# Dashboard → API Keys. Domain bizzio.online must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@bizzio.online
RESEND_FROM_NAME="Bizzio Online"

# ---- Razorpay (Pro-plan subscription payment only) --------------------------
# Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → the secret you set when creating the
# webhook pointed at /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ---- Web Push (VAPID keys for browser push notifications) ------------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@bizzio.online

# ---- SuperAdmin seed (used only by scripts/seed-superadmin.ts, one-time) ----
SEED_SUPERADMIN_EMAIL=admin@bizzio.online
SEED_SUPERADMIN_PASSWORD=